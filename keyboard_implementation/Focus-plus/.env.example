# Primary AI — Sarvam API
SARVAM_API_KEY=your_sarvam_api_key_here

# Fallback AI — Mistral API
MISTRAL_API_KEY=your_mistral_api_key_here

# Local Ollama override
# Set to "true" to use local Ollama instead of Sarvam/Mistral
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ESP32 hardware integration (Python stream_server.py only)
# Set ESP32_ENABLED=true to push cognitive load score + LED colour to the ESP32
ESP32_ENABLED=false
ESP32_ENDPOINT=http://10.213.16.171/load
ESP32_INTERVAL_SEC=1.0
# Number of LEDs in the ring — colour is broadcast to all LEDs
ESP32_LED_COUNT=12

# App Configuration
NEXT_PUBLIC_APP_NAME=NeuroSync
NEXT_PUBLIC_APP_URL=http://localhost:3000
