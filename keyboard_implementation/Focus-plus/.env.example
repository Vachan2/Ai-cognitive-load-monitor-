# Primary AI — Sarvam API
SARVAM_API_KEY=your_sarvam_api_key_here

# Fallback AI — Mistral API
MISTRAL_API_KEY=your_mistral_api_key_here

# Local Ollama override
# Set to "true" to use local Ollama instead of Sarvam/Mistral
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ESP32 hardware integration (Python stream_server.py only)
# Set ESP32_ENABLED=true to push cognitive load score + LED colour to the ESP32
ESP32_ENABLED=false
ESP32_ENDPOINT=http://10.213.16.171/load
ESP32_INTERVAL_SEC=1.0
# Number of LEDs in the ring — colour is broadcast to all LEDs
ESP32_LED_COUNT=12

# App Configuration
NEXT_PUBLIC_APP_NAME=NeuroSync
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Azure Foundry Voice Live integration (server-side only)
# Agent mode uses Microsoft Entra ID. Authenticate locally with `az login`,
# or provide the standard AZURE_CLIENT_ID / AZURE_TENANT_ID /
# AZURE_CLIENT_SECRET variables for a service principal.
VOICE_ALERTS_ENABLED=false
AZURE_VOICELIVE_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_FOUNDRY_AGENT_NAME=your-foundry-agent-name
AZURE_FOUNDRY_PROJECT_NAME=your-foundry-project-name
# Optional: pin an agent version for controlled testing.
AZURE_FOUNDRY_AGENT_VERSION=
# Optional cross-resource Foundry settings.
AZURE_FOUNDRY_RESOURCE_OVERRIDE=
AZURE_FOUNDRY_AUTHENTICATION_IDENTITY_CLIENT_ID=
# 10 minutes by default; can be lowered for testing.
NEXT_PUBLIC_VOICE_ALERT_COOLDOWN_SEC=600
